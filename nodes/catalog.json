  {
    "id": "state.rank1_operator_write",
    "version": "0.1.0",
    "role": "mechanism",
    "summary": "Persistent matrix state updated by addressed rank-1 writes; later probes are transformed by the accumulated operator.",
    "inputs": {
      "write": {
        "type": "vector",
        "required": false
      },
      "probe": {
        "type": "vector",
        "required": false
      }
    },
    "outputs": {
      "operator": {
        "type": "matrix"
      },
      "response": {
        "type": "vector",
        "optional": true
      }
    },
    "parameters": {
      "defaults": {
        "dim": 2,
        "eta": 0.35,
        "frozen": false
      }
    },
    "executor": "state.rank1_operator_write",
    "claims": [
      "Provides a deterministic calibration mechanism in which two addressed persistent writes can compose noncommutatively.",
      "The frozen parameter is a destructive control: writes are observed but do not alter the resident operator."
    ],
    "provenance": {
      "kind": "TheoryLab calibration primitive",
      "source": "Inspired by the operator-composition abstraction; not a biological model"
    },
    "tags": [
      "persistent-state",
