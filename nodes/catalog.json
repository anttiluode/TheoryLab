      "defaults": {
        "strategy": "online_sanger",
        "eta": 0.006,
        "decay_scale": 30000,
        "reorth_every": 20,
        "learner_seed_offset": 5000
      }
    },
    "executor": "learner.online_coordinate_tracking",
    "claims": [
      "The online_sanger strategy sees streaming state only; it is not given the hidden basis, drift angle or fast matrix.",
      "It tests whether continuing experience can preserve useful adaptation coordinates as the resident computation moves."
    ],
    "provenance": {
      "kind": "TheoryLab v3 generated-theory adapter",
      "source": "TheoryLab v2 result boundary; Sanger/Oja lineage; ThirdWay identity-continuation hypothesis"
