      "defaults": {
        "strategy": "pca_covariance",
        "iterations": 120,
        "random_seed_offset": 10000
      }
    },
    "executor": "learner.coordinate_basis",
    "claims": [
      "The pca_covariance strategy reads only the covariance sufficient statistic, not the oracle basis or fast matrix.",
      "It tests whether an ordinary global covariance learner can discover useful resident coordinates in the constructed matched world family."
    ],
    "provenance": {
      "kind": "TheoryLab v2 generated-theory adapter",
      "source": "TheoryLab basis_alignment proposal; Oja/PCA lineage is motivation, not yet the local-learning implementation"
