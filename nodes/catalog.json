        "covariance_seed": 200,
        "eigenvalues": [
          0.94,
          0.79,
          0.54,
          0.28
        ]
      }
    },
    "executor": "world.matched_recurrent_modes",
    "claims": [
      "Provides the same fixed recurrent substrate family to learned, visible, random and oracle coordinate strategies.",
      "Visible coordinates are deliberately maximally mixed in address energy, making this a known hard-attacker calibration rather than a generic RNN sample."
    ],
