{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anttiluode.github.io/TheoryLab/schemas/theory.schema.json",
  "title": "TheoryLab Theory v0",
  "type": "object",
  "required": ["format", "id", "title", "question", "hypothesis", "assumptions", "nodes", "edges", "experiments", "gates"],
  "properties": {
    "format": {"const": "theorylab-theory/v0"},
    "id": {"type": "string"},
    "title": {"type": "string"},
    "question": {"type": "string"},
    "hypothesis": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "node"],
        "properties": {
          "id": {"type": "string"},
          "node": {"type": "string"},
          "parameters": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
      }
    },
    "experiments": {"type": "array", "minItems": 1},
    "attackers": {"type": "array"},
    "gates": {"type": "array", "minItems": 1},
    "interpretation": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array"}
  },
  "additionalProperties": true
}
